# Copy to .env and fill in values for local development.
# Never commit the actual .env file.

# SQLAlchemy database URL.
# Leave empty to use the in-memory adapter (useful for local dev / tests).
# Examples:
#   sqlite:///./orders.db
#   postgresql+psycopg2://user:pass@localhost:5432/orders
DATABASE_URL=

# Outbound webhook URL for order-created notifications.
NOTIFICATION_WEBHOOK_URL=https://notifications.example.com/webhooks/orders

# Port the Uvicorn server will listen on inside the container.
PORT=8000
